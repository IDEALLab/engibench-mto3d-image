# Inputs consumed by build_image.sh.

# Published MTO2D runtime, pinned by manifest digest. It is a pinned source build of the same
# dependency revisions found inside the legacy MTO3D image MTO_GEN.sif
# (sha256 d53c0b6f8ec566b0d165be485efefde814e9f2af7e1e39f1ebc30a9a86ca62a6):
# OpenFOAM-5.x 7f7d351b741b, swak4Foam 9d8f12af95f5, Open MPI 4.0.4, PETSc 3.12, Scotch 6.0.8.
BASE_IMAGE='ghcr.io/ideallab/engibench-mto2d@sha256:2887a5c8eaa3fba2d2738188757aeb66fe69d8ef7060698cb8512252aacaa131'

# Deterministic manifest of case/ (find . -type f | sort | sha256sum per file | sha256sum).
# case/ is the golden MTO3D case 3Dheatsink_0 (inputs plus production solver source, no compiled
# EXEC) from the lab's 5,000-case MTO3D data-generation collection, laid out as app/{0,constant,system}
# and src/, plus xh_template.gz (its final 1922/xh.gz, the writer template). Every file is
# byte-identical to its source.
MTO3D_CASE_MANIFEST_SHA256='bda5d71a3b9e5e0f4cc7706d2abd6a524d9f1023f516ecbef2e9755ce040d5d8'

# SPDX expression for the published image label. It follows the MTO2D image (label GPL-3.0-or-later; its
# GPL-3.0-or-later recipe vendors the closely related MTO2D solver source) and adds LGPL-2.1-only for the MMA
# library inherited from the base image. Redistribution rights are still confirmed on every publish run (the
# Publish workflow's confirm_redistribution_rights input).
APPROVED_IMAGE_LICENSES='GPL-3.0-or-later AND LGPL-2.1-only'
