diff --color -ruN p01/frozenStatus.H p012/frozenStatus.H
--- a/src/frozenStatus.H	1970-01-01 01:00:00
+++ b/src/frozenStatus.H	2026-11-25 22:02:01
@@ -0,0 +1,30 @@
+// EngiBench patch 02: machine-readable record of a frozen evaluation (updateDesign no).
+// The primal NS loop above stops when both initial residuals reach tol_U/tol_p or after NSmaxIter
+// passes; a frozen evaluation is valid only if it converged. Objectives at full precision.
+if (Pstream::master())
+{
+    std::ofstream status("frozen_status.txt");
+    status.precision(17);
+    status << "iteration " << opt << "\n"
+           << "mean_temperature " << MeanT << "\n"
+           << "power_dissipation " << PowerDiss << "\n"
+           << "volume_residual " << V << "\n"
+           << "ns_passes " << iterNS << "\n"
+           << "ns_max_iter " << maxIterNS << "\n"
+           << "initial_residual_U " << initialResidual_U << "\n"
+           << "initial_residual_p " << initialResidual_p << "\n"
+           << "ns_converged "
+           << ((initialResidual_U <= convergenceTolerance_U && initialResidual_p <= convergenceTolerance_p) ? 1 : 0)
+           << "\n"
+           << "qu " << qu << "\n"
+           << "alphaMax " << alphaMax.value() << "\n"
+           << "elapsed_clock_time " << runTime.elapsedClockTime() << "\n";
+}
+// A flow that used all NSmaxIter passes without converging makes the evaluation invalid: stop now
+// instead of repeating that solve in each remaining iteration. Converged iterations never stop here.
+if (!(initialResidual_U <= convergenceTolerance_U && initialResidual_p <= convergenceTolerance_p))
+{
+    Info<< "EngiBench frozen evaluation: flow not converged within " << maxIterNS
+        << " SIMPLE passes; stopping." << endl;
+    runTime.writeAndEnd();
+}
