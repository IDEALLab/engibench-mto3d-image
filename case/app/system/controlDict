FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     MTO_TFS;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         3000;//计算到endTime停止

deltaT          1;//每次优化时间步长

writeControl    runTime;

writeInterval   1;//每隔5步往硬盘写一次数据

purgeWrite      1;

writeFormat     ascii;

writePrecision  3;//硬盘写数据时精度

writeCompression on;

timeFormat      general;

timePrecision   12;

runTimeModifiable true;
libs ( "libOpenFOAM.so" "libgroovyBC.so" ) ;//链接的库


functions
{
    fieldofinterest
    {
        type        writeObjects;
        libs        ("libutilityFunctionObjects.so");
        objects     (xh T U p);
        executeControl      writeTime;
        writeControl        writeTime;
    }
}




